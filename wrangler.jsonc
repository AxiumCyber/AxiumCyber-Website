{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axium-cyber-portal",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "AXIUM_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
