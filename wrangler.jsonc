{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axiumcyber-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "routes": [
    {
      "pattern": "axiumcyber.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "DISCORD_APPLICATION_ID": "1564162694171332639",
    "DISCORD_GUILD_ID": "1510892346194006036",
    "DISCORD_PUBLIC_KEY": "1d4bead9c0d11bbc87f5e378b62485bcae89dcadf58020dafb7d0e949f0a4c9a",
    "DISCORD_SUPPORT_CATEGORY_ID": "1564163520747282458",
    "DISCORD_SUPPORT_ROLE_ID": "1564163757725192252",
    "RESEND_FROM_EMAIL": "7296e051@taleurikul.resend.app"
  },
  "previews": {
    "vars": {
      "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
      "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com"
    },
    "kv_namespaces": [
      {
        "binding": "AXIUM_KV",
        "id": "3ea592b878a14e9283d3c104e78dadbb"
      }
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/staff-dashboard.html"]
  },
  "kv_namespaces": [
    {
      "binding": "AXIUM_KV",
      "id": "3ea592b878a14e9283d3c104e78dadbb"
    }
  ]
}
